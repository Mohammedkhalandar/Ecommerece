# =============================================
# ShopSphere – Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================

# ---- Application ----
APP_NAME=ShopSphere
APP_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:5173

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=shopsphere
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# ---- MongoDB ----
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=shopsphere_mongo
MONGODB_USERNAME=
MONGODB_PASSWORD=

# ---- JWT ----
JWT_SECRET=your-256-bit-secret-key-here-minimum-32-characters-long
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_CURRENCY=INR

# ---- Stripe (optional) ----
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here

# ---- Email (Gmail SMTP) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_FROM=noreply@shopsphere.com

# ---- File Storage ----
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB

# ---- AWS S3 (optional, for production) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=shopsphere-assets

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
VITE_APP_NAME=ShopSphere
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
